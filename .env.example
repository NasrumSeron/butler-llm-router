# Copy this file to `.env` and fill it in. NEVER commit `.env` to git.
#
#   Linux/macOS:  cp .env.example .env && nano .env
#   PowerShell:   Copy-Item .env.example .env ; notepad .env

# A NEW Telegram bot, separate from your calendar bot.
# Talk to @BotFather -> /newbot -> copy the token it gives you.
BUTLER_TELEGRAM_TOKEN=

# Your Gemini API key. Free tier is fine for routing.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram numeric user ID(s) allowed to use Butler, comma-separated.
# Message @userinfobot on Telegram to find yours. Butler refuses to start if empty.
BUTLER_ALLOWED_USER_IDS=

# Which address book to use.
#   LAPTOP  -> leave this commented out (defaults to services.yaml, 127.0.0.1 stubs)
#   DOCKER  -> UNCOMMENT the line below (Docker container names)
#
# BUTLER_SERVICES_FILE=services.docker.yaml

# Optional: turn off the HTTP front door (web.py) and run Telegram-only.
# BUTLER_WEB_ENABLED=0
